# PostgreSQL
POSTGRES_DB=autoflow
POSTGRES_USER=autoflow_user
POSTGRES_PASSWORD=strong_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth Service
AUTH_SERVICE_PORT=8081
JWT_SECRET=long random string

# GitHub OAuth2
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend origin (scheme+host+port only, no trailing slash or path)
FRONTEND_URL=http://localhost:3000

# Cookie security (set to true in production with HTTPS)
COOKIE_SECURE=false

# OAuth token encryption (AES-256-CBC via spring-security-crypto)
# ENCRYPTION_SECRET: any strong passphrase
# ENCRYPTION_SALT: exactly 16 random bytes as a 32-char hex string
#   Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_SECRET=change_me_strong_passphrase
ENCRYPTION_SALT=deadbeefdeadbeef0011223344556677

# Workflow Engine
WORKFLOW_ENGINE_PORT=8082